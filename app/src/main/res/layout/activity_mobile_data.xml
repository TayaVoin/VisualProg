<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/custom_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Отправка данных о сети"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Настройки сервера -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сервер"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/etServerIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="192.168.1.100"
            android:inputType="text"
            android:background="@drawable/player_btn_play"
            android:padding="8dp"
            android:textColor="#411E03" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Порт:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/etServerPort"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="50123"
            android:inputType="number"
            android:background="@drawable/player_btn_play"
            android:padding="8dp"
            android:textColor="#411E03" />
    </LinearLayout>

    <!-- Статус -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Статус: "
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отключено"
            android:textSize="16sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- Кнопки управления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnStartSending"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Начать отправку"
            android:background="@drawable/player_btn_play"
            android:textColor="#411E03"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStopSending"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/player_btn_prev"
            android:enabled="false"
            android:text="Остановить"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Тестовое соединение -->
    <Button
        android:id="@+id/btnTestConnection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Проверить соединение"
        android:layout_marginBottom="16dp"
        android:background="@drawable/player_btn_prev"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!-- Поле с последними данными -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Последние отправленные данные:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F0F0"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLastData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Нет данных"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Статистика -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tvPacketsSent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отправлено: 0"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvLastSendTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Последняя: никогда"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:gravity="end" />
    </LinearLayout>
</LinearLayout>