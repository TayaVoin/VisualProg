<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/custom_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Калькулятор -->
            <Button
                android:id="@+id/GoToCalc"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="📱 Calculator"
                android:layout_marginBottom="12dp"
                android:background="@drawable/button_rounded"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- Медиа плеер -->
            <Button
                android:id="@+id/GoToPlayer"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="🎵 Media Player"
                android:layout_marginBottom="12dp"
                android:background="@drawable/button_rounded"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- Geo Control (отображение локации) -->
            <Button
                android:id="@+id/GoToGeo"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="📍 Geo Control"
                android:layout_marginBottom="12dp"
                android:background="@drawable/button_rounded"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- ZMQ / Sockets (демо отправки) -->
            <Button
                android:id="@+id/GoToSockets"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="🔌 ZMQ / Sockets"
                android:layout_marginBottom="12dp"
                android:background="@drawable/button_rounded"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- Mobile Network Data (настройка и отправка данных о сети и местоположении) -->
            <Button
                android:id="@+id/GoToMobileData"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="📶 Mobile Network Data"
                android:layout_marginBottom="24dp"
                android:background="@drawable/button_rounded"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- Управление фоновым сервисом -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStartService"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="▶ Start Service"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/button_rounded"
                    android:textColor="#00FF00"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnStopService"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="⏹ Stop Service"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_rounded"
                    android:textColor="#FF4444"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Статус сервиса -->
            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сервис: остановлен"
                android:textSize="14sp"
                android:textColor="#888888"
                android:gravity="center"
                android:paddingTop="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>